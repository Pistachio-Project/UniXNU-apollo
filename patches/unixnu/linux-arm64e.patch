diff --git a/scripts/unixnu/kernel.py b/scripts/unixnu/kernel.py
index 9924ddb..bed7794 100644
--- a/scripts/unixnu/kernel.py
+++ b/scripts/unixnu/kernel.py
@@ -191,6 +191,16 @@ def build(ctx, modules):
         tool('xcodebuild', 'the kernel step builds with the Xcode iphoneos SDK')
     env.update(xnu_env(ctx))
     env.update(version_env(modules, ctx))
+    if platform.system() == 'Linux':
+        # The cross compiler and the SDK shims follow the selected architecture and OS profiles. An arm64e kernel also
+        # takes the function pointer type discrimination Apple clang turns on for -mkernel (scripts/linux/clang).
+        arch, ios = env.get('UNIXNU_XNU_ARCH', 'arm64'), env.get('UNIXNU_IOS_VERSION', '17.0')
+        env['DARWIN_TRIPLE'], env['UNIXNU_SDK_VERSION'] = f'{arch}-apple-ios{ios}', ios
+        if arch == 'arm64e':
+            # ... and the __ARM_ARCH_8_x__ macros Apple clang predefines for the arm64e default CPU (apple-a12, ARMv8.3),
+            # which xnu selects its LSE atomics, PAN/UAO and RCPC paths by.
+            env['CROSS_EXTRA_FLAGS'] = ('-fptrauth-function-pointer-type-discrimination -D__ARM_ARCH_8_2__=1 '
+                                        '-D__ARM_ARCH_8_3__=1 ' + env['CROSS_EXTRA_FLAGS'])
     if ctx.schema_version == 2:
         env['UNIXNU_PATCH_LIST'] = str(patches.prepare(ctx, modules))
         generated = ctx.tree / 'build/generated'
