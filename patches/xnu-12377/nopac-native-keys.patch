diff --git a/osfmk/arm64/locore.s b/osfmk/arm64/locore.s
index 51ab98c..951219c 100644
--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -907,7 +907,7 @@ el1_sp1_serror_vector_long:
 
 .macro EL0_64_VECTOR guest_label
 	stp		x0, x1, [sp, #-16]!					// Save x0 and x1 to the exception stack
-#if HAS_NATIVE_PAC
+#if HAS_NATIVE_PAC && !NATIVE_PAC_STRIPPED
 	/*
 	 * An arm64 (non-arm64e) thread runs with the PAC keys off at EL0, and
 	 * SCTLR_EL1 controls EL1 as well. Turn them back on before the first
@@ -920,7 +920,7 @@ el1_sp1_serror_vector_long:
 	msr		SCTLR_EL1, x0
 	isb		sy
 Lel0_jop_keys_on_\@:
-#endif /* HAS_NATIVE_PAC */
+#endif /* HAS_NATIVE_PAC && !NATIVE_PAC_STRIPPED */
 #if __ARM_KERNEL_PROTECT__
 	mov		x18, #0 						// Zero x18 to avoid leaking data to user SS
 #endif
@@ -2069,7 +2069,7 @@ Lno_gcr_mask_el0_reset:
 #endif  /* defined(ERET_IS_NOT_CONTEXT_SYNCHRONIZING) && !__ARM_KERNEL_PROTECT__ */
 	strb	wzr, [x1, CPU_SYNC_ON_CSWITCH]
 
-#if HAS_NATIVE_PAC
+#if HAS_NATIVE_PAC && !NATIVE_PAC_STRIPPED
 	/*
 	 * An arm64 (non-arm64e) thread returns to EL0 with all PAC keys off: it
 	 * signs nothing, and arm64e libraries authenticate its return addresses
@@ -2090,7 +2090,7 @@ Lno_gcr_mask_el0_reset:
 	orr		x5, x5, #(1 << BIT_ISB_PENDING)
 #endif /* ERET_NEEDS_ISB */
 Lskip_user_jop_keys_off:
-#endif /* HAS_NATIVE_PAC */
+#endif /* HAS_NATIVE_PAC && !NATIVE_PAC_STRIPPED */
 
 #if ERET_NEEDS_ISB
 	// Apply any pending isb from earlier.
diff --git a/osfmk/arm64/pac_asm.h b/osfmk/arm64/pac_asm.h
index 3d096ca..f1b5631 100644
--- a/osfmk/arm64/pac_asm.h
+++ b/osfmk/arm64/pac_asm.h
@@ -150,7 +150,7 @@
  *   tmp2 - scratch register
  */
 .macro PAC_INIT_KEY_STATE	tmp, tmp2
-#if HAS_NATIVE_PAC
+#if HAS_NATIVE_PAC && !NATIVE_PAC_STRIPPED
 	/*
 	 * ARMv8.3 keys are shared by EL0 and EL1. The kernel and every process
 	 * use one key set per boot. The first CPU through here derives it from
@@ -198,7 +198,7 @@
 	msr		APGAKeyLo_EL1, x2
 	msr		APGAKeyHi_EL1, x3
 	isb		sy
-#endif /* HAS_NATIVE_PAC */
+#endif /* HAS_NATIVE_PAC && !NATIVE_PAC_STRIPPED */
 #if HAS_PARAVIRTUALIZED_PAC
 #if HIBERNATION
 	#error PAC_INIT_KEY_STATE is not implemented for HAS_PARAVIRTUALIZED_PAC && HIBERNATION
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 8f83d0a..b4c0bd1 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -738,7 +738,7 @@
 #define SCTLR_EOS_DEFAULT         (SCTLR_EOS)
 #endif
 
-#if   HAS_APPLE_PAC
+#if   HAS_APPLE_PAC && !NATIVE_PAC_STRIPPED
 #define SCTLR_PAC_KEYS_DEFAULT  SCTLR_PAC_KEYS_ENABLED
 #else /* !HAS_APPLE_PAC */
 #define SCTLR_PAC_KEYS_DEFAULT  0
diff --git a/pexpert/pexpert/arm64/BCM2837.h b/pexpert/pexpert/arm64/BCM2837.h
index 10454e8..fc9b9f5 100644
--- a/pexpert/pexpert/arm64/BCM2837.h
+++ b/pexpert/pexpert/arm64/BCM2837.h
@@ -39,6 +39,15 @@
 #if defined(__arm64e__)
 #define HAS_APPLE_PAC             1
 #define HAS_NATIVE_PAC            1
+/*
+ * The CPUs of this board (Cortex-A77 and Cortex-A55, ARMv8.2) have no pointer
+ * authentication. The kernel keeps the arm64e ABI of the kexts it links, and
+ * its image is rewritten after the link (package/pacstrip): PAC*, AUT* and
+ * XPAC* become NOP and the authenticated branches and loads their plain
+ * forms, so a pointer is never signed. The key registers and the SCTLR_EL1
+ * key enables do not exist here and must not be written.
+ */
+#define NATIVE_PAC_STRIPPED       1
 #endif
 
 #ifndef ASSEMBLER
