diff --git a/osfmk/arm64/nopac_rewrite.c b/osfmk/arm64/nopac_rewrite.c
new file mode 100644
index 0000000..6596d93
--- /dev/null
+++ b/osfmk/arm64/nopac_rewrite.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: MIT
+/*
+ * See nopac_rewrite.h. Pointers are never signed on a CPU without pointer
+ * authentication, so PAC*, AUT* and XPAC* become NOP, the authenticated
+ * branches and loads become their plain forms, and PACGA becomes a
+ * deterministic EOR. Forms with no 4-byte replacement (LDRAA/LDRAB outside the
+ * LDR/LDUR offset range, FJCVTZS) are left for the trap emulator
+ * (nopac_emulate.c).
+ */
+#include <arm64/nopac_rewrite.h>
+
+#define NOP             0xD503201Fu
+#define RET             0xD65F03C0u
+#define ERET            0xD69F03E0u
+#define BR              0xD61F0000u
+#define BLR             0xD63F0000u
+#define LDR_UNSIGNED    0xF9400000u
+#define LDUR            0xF8400000u
+#define LDR_PRE_INDEX   0xF8400C00u
+#define EOR_ROR_13      (0xCAC00000u | 13u << 10)
+
+static inline uint32_t
+rewrite_load(uint32_t word)
+{
+	int32_t raw = (int32_t)((word >> 22 & 1) << 9 | (word >> 12 & 0x1FF));
+	int32_t offset = ((raw & 0x200) ? raw - 0x400 : raw) * 8;
+	uint32_t registers = word & 0x3FF;
+	uint32_t imm9 = (uint32_t)offset & 0x1FF;
+
+	if (word >> 11 & 1) {
+		return (offset < -256 || offset > 255) ? word : (LDR_PRE_INDEX | imm9 << 12 | registers);
+	}
+	if (offset >= 0) {
+		return LDR_UNSIGNED | (uint32_t)(offset >> 3) << 10 | registers;
+	}
+	return offset >= -256 ? (LDUR | imm9 << 12 | registers) : word;
+}
+
+static inline uint32_t
+rewrite_word(uint32_t word)
+{
+	/*
+	 * Every form handled here has one of these top bytes; most instructions
+	 * of a page leave after this test.
+	 */
+	switch (word >> 24) {
+	case 0xD6:
+		if ((word & 0xFFFFFBFFu) == 0xD65F0BFFu) {              /* RETAA, RETAB */
+			return RET;
+		}
+		if ((word & 0xFFFFFBFFu) == 0xD69F0BFFu) {              /* ERETAA, ERETAB */
+			return ERET;
+		}
+		if ((word & 0xFFFFF81Fu) == 0xD61F081Fu) {              /* BRAAZ, BRABZ */
+			return BR | (word & 0x3E0);
+		}
+		if ((word & 0xFFFFF81Fu) == 0xD63F081Fu) {              /* BLRAAZ, BLRABZ */
+			return BLR | (word & 0x3E0);
+		}
+		return word;
+	case 0xD7:
+		if ((word & 0xFFFFF800u) == 0xD71F0800u) {              /* BRAA, BRAB */
+			return BR | (word & 0x3E0);
+		}
+		if ((word & 0xFFFFF800u) == 0xD73F0800u) {              /* BLRAA, BLRAB */
+			return BLR | (word & 0x3E0);
+		}
+		return word;
+	case 0xDA:
+		if ((word & 0xFFFF0000u) == 0xDAC10000u) {              /* PAC*, AUT*, XPAC* */
+			uint32_t opcode = word >> 10 & 0x3F;
+			if (opcode <= 0x11 && (opcode < 0x08 || (word >> 5 & 0x1F) == 31)) {
+				return NOP;
+			}
+		}
+		return word;
+	case 0x9A:
+		if ((word & 0xFFE0FC00u) == 0x9AC03000u) {              /* PACGA */
+			return EOR_ROR_13 | (word & 0x001F03FFu);
+		}
+		return word;
+	case 0xF8:
+		if ((word & 0xFF200400u) == 0xF8200400u) {              /* LDRAA, LDRAB */
+			return rewrite_load(word);
+		}
+		return word;
+	default:
+		return word;
+	}
+}
+
+size_t
+nopac_rewrite_words(uint32_t *words, size_t count)
+{
+	size_t changed = 0;
+
+	for (size_t i = 0; i < count; i++) {
+		uint32_t word = words[i], replacement = rewrite_word(word);
+		if (replacement != word) {
+			words[i] = replacement;
+			changed++;
+		}
+	}
+	return changed;
+}
