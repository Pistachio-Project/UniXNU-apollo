diff --git a/osfmk/arm64/bootlog.c b/osfmk/arm64/bootlog.c
new file mode 100644
index 0000000..379faa9
--- /dev/null
+++ b/osfmk/arm64/bootlog.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+/*
+ * Boot log in a Linux ramoops console zone; see bootlog.h.
+ *
+ * The zone layout is Linux's struct persistent_ram_buffer (fs/pstore/ram_core.c)
+ * without ECC: a signature, the write position, the number of valid bytes and
+ * the text as a ring. The zone must lie outside the memory the kernel manages
+ * (the firmware reserves it) and is mapped as device memory, so a byte is in
+ * DRAM when the store completes and a reset loses nothing.
+ */
+#include <arm64/bootlog.h>
+#include <arm64/proc_reg.h>
+#include <kern/startup.h>
+#include <libkern/OSAtomic.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <stdint.h>
+#include <string.h>
+
+#define PERSISTENT_RAM_SIG      0x43474244u     /* "DBGC" */
+#define BOOTLOG_DEFAULT_SIZE    0x200000u
+#define BOOTLOG_EARLY_SIZE      0x4000u
+#define PSCI_SYSTEM_RESET       0x84000009u
+
+struct persistent_ram_buffer {
+	uint32_t sig;
+	uint32_t start;
+	uint32_t size;
+	uint8_t  data[];
+};
+
+static volatile struct persistent_ram_buffer *bootlog_zone;
+static uint32_t bootlog_capacity;
+static volatile uint32_t bootlog_position;      /* bytes written since the log opened */
+static uint64_t bootlog_deadline;               /* counter value of the timed reset; 0: none */
+static bool bootlog_panic_reset = true;
+static bool bootlog_psci_hvc;
+
+/* Qualcomm APSS watchdog (Linux drivers/watchdog/qcom-wdt.c): counter reset and enable registers. */
+#define APSS_WDT_RST            0x04
+#define APSS_WDT_EN             0x08
+static volatile uint32_t *bootlog_wdt;
+static uint64_t bootlog_wdt_fed;                /* counter value of the last feed */
+static uint64_t bootlog_second;                 /* counter ticks in a second */
+static uint64_t bootlog_opened;                 /* counter value when the log opened */
+
+/* What is printed before the zone is mapped. */
+static char bootlog_early[BOOTLOG_EARLY_SIZE];
+static volatile uint32_t bootlog_early_length;
+
+static inline uint64_t
+bootlog_counter(void)
+{
+	return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+bool
+bootlog_active(void)
+{
+	return bootlog_zone != NULL;
+}
+
+void
+bootlog_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+
+	(void)ml_set_interrupts_enabled(FALSE);
+	if (bootlog_psci_hvc) {
+		__asm__ volatile ("hvc #0" : "+r"(x0) : : "x1", "x2", "x3");
+	} else {
+		__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3");
+	}
+	for (;;) {
+		__asm__ volatile ("wfi");
+	}
+}
+
+static inline void
+bootlog_store(char c)
+{
+	volatile struct persistent_ram_buffer *zone = bootlog_zone;
+	uint32_t position = OSIncrementAtomic((volatile SInt32 *)&bootlog_position);
+
+	zone->data[position % bootlog_capacity] = (uint8_t)c;
+	/*
+	 * Several CPUs can be here at once and the header is not updated
+	 * atomically with the byte; a later store repairs it. The reader gets
+	 * the ring from `start` on, then the bytes before it.
+	 */
+	zone->start = (position + 1) % bootlog_capacity;
+	zone->size = (position + 1) < bootlog_capacity ? (position + 1) : bootlog_capacity;
+}
+
+void
+bootlog_putc(char c)
+{
+	if (c == '\r') {
+		return;
+	}
+	if (bootlog_zone == NULL) {
+		uint32_t at = OSIncrementAtomic((volatile SInt32 *)&bootlog_early_length);
+		if (at < BOOTLOG_EARLY_SIZE) {
+			bootlog_early[at] = c;
+		}
+		if (c == '\n') {
+			bootlog_poll();
+		}
+		return;
+	}
+	bootlog_store(c);
+	if (c == '\n') {
+		bootlog_poll();
+	}
+}
+
+void
+bootlog_poll(void)
+{
+	if (bootlog_wdt != NULL) {
+		uint64_t now = bootlog_counter();
+
+		/* Racing CPUs only feed it twice. */
+		if (now - bootlog_wdt_fed >= bootlog_second) {
+			bootlog_wdt_fed = now;
+			bootlog_wdt[APSS_WDT_RST / 4] = 1;
+		}
+	}
+	if (bootlog_deadline != 0 && bootlog_counter() >= bootlog_deadline) {
+		static const char text[] = "\nbootlog: timed reset\n";
+
+		bootlog_deadline = 0;
+		for (unsigned i = 0; i < sizeof(text) - 1; i++) {
+			bootlog_store(text[i]);
+		}
+		bootlog_reset();
+	}
+}
+
+static void
+bootlog_text(const char *text)
+{
+	while (*text) {
+		bootlog_putc(*text++);
+	}
+}
+
+static void
+bootlog_number(uint64_t value, unsigned digits)
+{
+	char text[21];
+	unsigned at = sizeof(text) - 1;
+
+	text[at] = 0;
+	do {
+		text[--at] = (char)('0' + value % 10);
+		value /= 10;
+	} while (at > 0 && (value != 0 || sizeof(text) - 1 - at < digits));
+	bootlog_text(&text[at]);
+}
+
+static void
+bootlog_stamp(void)
+{
+	uint64_t ticks = bootlog_counter() - bootlog_opened, second = bootlog_second ? bootlog_second : 1;
+
+	bootlog_putc('[');
+	bootlog_number(ticks / second, 1);
+	bootlog_putc('.');
+	bootlog_number(ticks % second * 1000 / second, 3);
+	bootlog_text("] ");
+}
+
+void
+bootlog_stage(const char *stage)
+{
+	if (bootlog_zone == NULL) {
+		return;
+	}
+	bootlog_stamp();
+	bootlog_text(stage);
+	if (stage[0] == 0 || stage[strlen(stage) - 1] != '\n') {
+		bootlog_putc('\n');
+	}
+}
+
+void
+bootlog_process(int pid, const char *name, const char *stage)
+{
+	if (bootlog_zone == NULL) {
+		return;
+	}
+	bootlog_stamp();
+	bootlog_text(name);
+	bootlog_putc('[');
+	bootlog_number((uint64_t)(pid < 0 ? 0 : pid), 1);
+	bootlog_text("] ");
+	bootlog_text(stage);
+	bootlog_putc('\n');
+}
+
+void
+bootlog_panic_halt(void)
+{
+	if (bootlog_zone == NULL || !bootlog_panic_reset) {
+		return;
+	}
+	/* Leave the panic text on the screen for a moment, then give the phone back to its own system. */
+	uint64_t until = bootlog_counter() + 5 * __builtin_arm_rsr64("CNTFRQ_EL0");
+	while (bootlog_counter() < until) {
+	}
+	bootlog_reset();
+}
+
+void
+bootlog_init(void)
+{
+	uint64_t address = 0, size = BOOTLOG_DEFAULT_SIZE, seconds = 0, on_panic = 1, wdt = 0, wdt_off = 0;
+	char conduit[8] = "";
+
+	bootlog_second = __builtin_arm_rsr64("CNTFRQ_EL0");
+	if (bootlog_wdt == NULL && PE_parse_boot_argn("bootlog-wdt", &wdt, sizeof(wdt)) && wdt != 0) {
+		volatile uint32_t *registers = (volatile uint32_t *)ml_io_map((vm_offset_t)wdt, 0x1000);
+
+		(void)PE_parse_boot_argn("bootlog-wdt-off", &wdt_off, sizeof(wdt_off));
+		if (registers != NULL && wdt_off != 0) {
+			registers[APSS_WDT_EN / 4] = 0;
+		} else if (registers != NULL) {
+			registers[APSS_WDT_RST / 4] = 1;
+			bootlog_wdt_fed = bootlog_counter();
+			bootlog_wdt = registers;
+		}
+	}
+	if (bootlog_zone != NULL || !PE_parse_boot_argn("bootlog", &address, sizeof(address)) || address == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("bootlog-size", &size, sizeof(size));
+	(void)PE_parse_boot_argn("bootlog-reset", &seconds, sizeof(seconds));
+	if (PE_parse_boot_argn("bootlog-panic", &on_panic, sizeof(on_panic))) {
+		bootlog_panic_reset = on_panic != 0;
+	}
+	if (PE_parse_boot_argn("bootlog-psci", conduit, sizeof(conduit))) {
+		bootlog_psci_hvc = strncmp(conduit, "hvc", sizeof(conduit)) == 0;
+	}
+	if (size <= sizeof(struct persistent_ram_buffer) + 4096 || size > 0x4000000) {
+		return;
+	}
+
+	volatile struct persistent_ram_buffer *zone =
+	    (volatile struct persistent_ram_buffer *)ml_io_map((vm_offset_t)address, (vm_size_t)size);
+	if (zone == NULL) {
+		return;
+	}
+	bootlog_capacity = (uint32_t)(size - sizeof(struct persistent_ram_buffer));
+	zone->sig = PERSISTENT_RAM_SIG;
+	zone->start = 0;
+	zone->size = 0;
+	if (seconds != 0) {
+		bootlog_deadline = bootlog_counter() + seconds * __builtin_arm_rsr64("CNTFRQ_EL0");
+	}
+	bootlog_opened = bootlog_counter();
+	bootlog_zone = zone;
+
+	uint32_t early = bootlog_early_length;
+	if (early > BOOTLOG_EARLY_SIZE) {
+		early = BOOTLOG_EARLY_SIZE;
+	}
+	for (uint32_t i = 0; i < early; i++) {
+		bootlog_store(bootlog_early[i]);
+	}
+	kprintf("bootlog: zone 0x%llx, %u bytes, reset after %llu s\n", address, bootlog_capacity, seconds);
+}
diff --git a/osfmk/arm64/bootlog.h b/osfmk/arm64/bootlog.h
new file mode 100644
index 0000000..8c9c224
--- /dev/null
+++ b/osfmk/arm64/bootlog.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+/*
+ * Boot log in a Linux ramoops console zone.
+ *
+ * The kernel console and kprintf are copied into a RAM region that survives a
+ * warm reset and that the phone's own Android kernel publishes afterwards as
+ * /sys/fs/pstore/console-ramoops-0. Boot arguments:
+ *
+ *   bootlog=ADDR         physical address of the ramoops console zone (required)
+ *   bootlog-size=BYTES   size of the zone, header included (default 0x200000)
+ *   bootlog-reset=SECS   reset through PSCI this many seconds after the log
+ *                        opens, whatever the kernel is doing (0: never, default)
+ *   bootlog-panic=0      stay in the panic spin instead of resetting
+ *   bootlog-psci=hvc     PSCI conduit (default smc)
+ *   bootlog-wdt=ADDR     physical address of a Qualcomm APSS watchdog the firmware armed
+ *                        (apollo: 0x17c10000). It is fed from the console and from every
+ *                        interrupt, at most once a second, so only a kernel that stops
+ *                        taking interrupts meets it. bootlog-wdt-off=1 disables it instead.
+ */
+#ifndef _ARM64_BOOTLOG_H_
+#define _ARM64_BOOTLOG_H_
+
+#include <stdbool.h>
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+void bootlog_init(void);
+bool bootlog_active(void);
+void bootlog_putc(char c);
+void bootlog_poll(void);
+void bootlog_panic_halt(void);
+void bootlog_reset(void) __dead2;
+/* The stage names of kern/boot_progress.h, with the seconds since the log opened. */
+void bootlog_stage(const char *stage);
+void bootlog_process(int pid, const char *name, const char *stage);
+__END_DECLS
+
+#endif /* _ARM64_BOOTLOG_H_ */
