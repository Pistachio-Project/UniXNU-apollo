+// SPDX-License-Identifier: BSD-2-Clause-Patent
+/*
+ * Board hooks of the iPadOS 27 bring-up series (UniXNU-sheng) that apollo has
+ * no implementation for yet. The series declares them weak, but an arm64e link
+ * cannot leave the authenticated pointer of an undefined weak symbol
+ * unresolved, so they are defined here as the absent case. They move to the
+ * board's storage archive when apollo has one (porting.toml, area "storage").
+ */
+#include <stdint.h>
+#include <sys/types.h>
+
+void native_source_storage_start(void);
+void boot_cache_input_capture(user_addr_t address, uint64_t length);
+
+/* Rounds the board's log writer has completed; bsd_init waits for the first with log=1. Nothing writes one here. */
+volatile uint32_t boot_log_rounds = 1;
+
+void
+native_source_storage_start(void)
+{
+}
+
+void
+boot_cache_input_capture(__unused user_addr_t address, __unused uint64_t length)
+{
+}
